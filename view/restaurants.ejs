<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('includes/head') %>
    <link rel="stylesheet" href="styles/restaurants.css" />
</head>

<body>
  <header id="main-header">
    <%- include('includes/header') %>
  </header>

  <aside id="mobile-drawer">
    <nav>
      <ul>
        <li class="nav-item"><a href="restaurants.html">Browse Restaurants</a></li>
        <li class="nav-item"><a href="recommend.html">Share a Restaurant</a></li>
        <li class="nav-item"><a href="about.html">About Eatwell</a></li>
      </ul>
    </nav>
  </aside>
  <main>
    <h1>Recommended restaurants</h1>
    <p>We found <%= restaurants%> restaurant</p>
    <p id="count-msg">Find your next favorite restaurants with help of our other users!</p>
    <ul id="restaurants-list">
      <% for (const restaurant of storedRes) { %>
        <li class="restaurant-item">
          <article>
            <h2>
              <%= restaurant.name %>
            </h2>
            <div class="restaurant-meta">
              <p>
                <%= restaurant.cuisine %>
              </p>
              <p>
                <%= restaurant.address %>
              </p>
            </div>
            <p>
              <%= restaurant.description %>
            </p>
            <div class="restaurant-actions">
              <a href="">View Website</a>
            </div>
          </article>
        </li>
        <% } %>
    </ul>
  </main>
</body>

</html>